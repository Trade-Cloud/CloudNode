import { Theme, Metrics } from "theme.slint";
import { VerticalHairline } from "widgets.slint";
import { Sidebar } from "sidebar.slint";
import { SessionArea } from "session.slint";
import { HostList, AddServerDialog } from "hosts.slint";

// Everything inside the window: the sidebar, a hairline, and the sessions; dialogs over them.
export component Shell inherits Rectangle {
    background: Theme.content-bg;

    HorizontalLayout {
        Sidebar {
            width: Metrics.rail-width + 1px + Metrics.panel-width;
        }

        VerticalHairline { }

        SessionArea {
            horizontal-stretch: 1;
        }
    }

    if HostList.form-open: AddServerDialog {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
    }
}
