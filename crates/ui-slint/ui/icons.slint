import { Theme, Metrics } from "theme.slint";

// CloudNode's icons: simple line drawings on a 24-unit grid, drawn here as SVG path data. They are
// original work (ATTRIBUTION.md); never trace them from another app's icons.
export global Icons {
    out property <string> home: "M3 10.5 L12 3 L21 10.5 V20 A1 1 0 0 1 20 21 H15 V14 H9 V21 H4 A1 1 0 0 1 3 20 Z";
    out property <string> terminal: "M4 17 L10 11 L4 5 M12 19 L20 19";
    out property <string> window: "M3 6 A2 2 0 0 1 5 4 H19 A2 2 0 0 1 21 6 V18 A2 2 0 0 1 19 20 H5 A2 2 0 0 1 3 18 Z M3 9 H21";
    // A key lying on its side: the bow on the left, two teeth on the right.
    out property <string> key: "M7.5 16.5 A4.5 4.5 0 1 0 7.5 7.5 A4.5 4.5 0 1 0 7.5 16.5 Z M12 12 H21 M17.5 12 V15 M21 12 V14.5";
    // Two stacked server units with a status light each.
    out property <string> server: "M4 4 H20 A1 1 0 0 1 21 5 V10 A1 1 0 0 1 20 11 H4 A1 1 0 0 1 3 10 V5 A1 1 0 0 1 4 4 Z M4 13 H20 A1 1 0 0 1 21 14 V19 A1 1 0 0 1 20 20 H4 A1 1 0 0 1 3 19 V14 A1 1 0 0 1 4 13 Z M7 6.7 A0.8 0.8 0 1 0 7 8.3 A0.8 0.8 0 1 0 7 6.7 Z M7 15.7 A0.8 0.8 0 1 0 7 17.3 A0.8 0.8 0 1 0 7 15.7 Z";
    out property <string> folder: "M3 7 A2 2 0 0 1 5 5 H9 L11 7 H19 A2 2 0 0 1 21 9 V18 A2 2 0 0 1 19 20 H5 A2 2 0 0 1 3 18 Z";
    out property <string> help: "M12 22 A10 10 0 1 0 12 2 A10 10 0 1 0 12 22 Z M9.5 9.5 A2.5 2.5 0 1 1 13.2 11.7 C12.4 12.2 12 12.8 12 13.6 V14 M12 17 A0.8 0.8 0 1 0 12 18.6 A0.8 0.8 0 1 0 12 17 Z";
    // A cog with eight teeth (radius 10 at the tips, 7.4 between them) around a hub.
    out property <string> settings: "M10.27 4.80 L10.52 2.11 L13.48 2.11 L13.73 4.80 A7.4 7.4 0 0 1 15.87 5.69 L17.95 3.96 L20.04 6.05 L18.31 8.13 A7.4 7.4 0 0 1 19.20 10.27 L21.89 10.52 L21.89 13.48 L19.20 13.73 A7.4 7.4 0 0 1 18.31 15.87 L20.04 17.95 L17.95 20.04 L15.87 18.31 A7.4 7.4 0 0 1 13.73 19.20 L13.48 21.89 L10.52 21.89 L10.27 19.20 A7.4 7.4 0 0 1 8.13 18.31 L6.05 20.04 L3.96 17.95 L5.69 15.87 A7.4 7.4 0 0 1 4.80 13.73 L2.11 13.48 L2.11 10.52 L4.80 10.27 A7.4 7.4 0 0 1 5.69 8.13 L3.96 6.05 L6.05 3.96 L8.13 5.69 A7.4 7.4 0 0 1 10.27 4.80 Z M12 15 A3 3 0 1 0 12 9 A3 3 0 1 0 12 15 Z";
    out property <string> search: "M11 18 A7 7 0 1 0 11 4 A7 7 0 1 0 11 18 Z M21 21 L16 16";
    // Filled dots: draw these with `filled: true`.
    out property <string> more-horizontal: "M3.4 12 A1.6 1.6 0 1 0 6.6 12 A1.6 1.6 0 1 0 3.4 12 Z M10.4 12 A1.6 1.6 0 1 0 13.6 12 A1.6 1.6 0 1 0 10.4 12 Z M17.4 12 A1.6 1.6 0 1 0 20.6 12 A1.6 1.6 0 1 0 17.4 12 Z";
    out property <string> more-vertical: "M12 3.4 A1.6 1.6 0 1 0 12 6.6 A1.6 1.6 0 1 0 12 3.4 Z M12 10.4 A1.6 1.6 0 1 0 12 13.6 A1.6 1.6 0 1 0 12 10.4 Z M12 17.4 A1.6 1.6 0 1 0 12 20.6 A1.6 1.6 0 1 0 12 17.4 Z";
}

// One icon: `commands` takes a path from Icons. Lines by default; `filled` for the dot icons.
export component Icon inherits Path {
    in property <brush> tint: Theme.ink;
    in property <bool> filled;

    width: Metrics.icon-size;
    height: Metrics.icon-size;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: root.filled ? transparent : root.tint;
    stroke-width: 1.6px;
    fill: root.filled ? root.tint : transparent;
}
