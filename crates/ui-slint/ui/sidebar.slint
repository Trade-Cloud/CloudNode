import { Theme, Metrics, Chrome } from "theme.slint";
import { SectionHeader, VerticalHairline } from "widgets.slint";
import { Panel, NavRail } from "rail.slint";
import { HomePanel } from "hosts.slint";
import { KeysPanel } from "keys.slint";

// A panel whose content comes in a later version.
component LaterPanel inherits Rectangle {
    in property <string> title;

    VerticalLayout {
        padding: Metrics.space-md;
        padding-top: Chrome.titlebar-inset + Metrics.space-md;
        spacing: Metrics.space-sm;
        alignment: start;

        SectionHeader {
            text: root.title;
        }

        Text {
            text: @tr("This comes in a later version of CloudNode.");
            color: Theme.faint;
            font-size: Metrics.font-body;
            wrap: word-wrap;
        }
    }
}

// The sidebar: the icon rail, a hairline, and the panel the rail has open.
export component Sidebar inherits Rectangle {
    in-out property <Panel> panel: Panel.hosts;

    background: Theme.sidebar-bg;

    HorizontalLayout {
        NavRail {
            width: Metrics.rail-width;
            panel <=> root.panel;
        }

        VerticalHairline { }

        Rectangle {
            width: Metrics.panel-width;

            if root.panel == Panel.hosts: HomePanel {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
            }

            if root.panel == Panel.keys: KeysPanel {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
            }

            if root.panel != Panel.hosts && root.panel != Panel.keys: LaterPanel {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: parent.height;
                title: root.panel == Panel.snippets ? @tr("SNIPPETS")
                    : root.panel == Panel.forwarding ? @tr("PORT FORWARDING")
                    : root.panel == Panel.sftp ? @tr("SFTP")
                    : root.panel == Panel.help ? @tr("HELP")
                    : @tr("SETTINGS");
            }
        }
    }
}
