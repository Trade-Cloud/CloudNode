// Colour tokens. The values come from Rust (`cloudnode_core::theme::Tokens`, set by
// `cloudnode_ui_slint::theme::apply` before the window opens), so the window, the TUI and the
// terminal renderer share one palette. Never write a colour literal in any other .slint file.
export global Theme {
    // The icon rail, the left panel and the middle of the window, behind everything.
    in property <color> rail-bg;
    in property <color> sidebar-bg;
    in property <color> content-bg;
    // The main surface in front: the session panel, menus, popovers.
    in property <color> surface;
    // Elements in the foreground: fields, buttons, the selected row.
    in property <color> element;
    in property <color> element-hover;
    // Text and icons; the strong form for headings and typed text, the faint one for hints.
    in property <color> ink;
    in property <color> ink-strong;
    in property <color> faint;
    in property <color> line;
    in property <color> line-strong;
    // Selected icons (the open panel), focus, the active session.
    in property <color> accent;
    in property <color> accent-hover;
    in property <color> on-accent;
    in property <color> selection;
    in property <color> good;
    in property <color> warn;
    in property <color> bad;
    in property <color> terminal-bg;
    in property <color> terminal-fg;
}

// The window's frame, set from Rust (`src/chrome.rs`). On macOS the title bar is transparent and
// its window buttons sit over the top of the window, so the sidebar and the sessions keep this
// much room there. Elsewhere the title bar is native and this stays 0.
export global Chrome {
    in property <length> titlebar-inset: 0px;
}

// Sizes, radii and type. Only the window uses them, so they live here rather than in Rust.
export global Metrics {
    out property <length> radius-sm: 6px;
    out property <length> radius-md: 8px;
    out property <length> radius-lg: 12px;

    out property <length> space-xs: 4px;
    out property <length> space-sm: 8px;
    out property <length> space-md: 12px;
    out property <length> space-lg: 16px;
    out property <length> space-xl: 24px;

    // The sidebar: the icon rail, a hairline, and the panel the rail opens.
    out property <length> rail-width: 52px;
    out property <length> rail-item-height: 40px;
    out property <length> rail-button: 36px;
    out property <length> panel-width: 248px;
    // Key Management scrolls beyond this, so the host lists above keep their room.
    out property <length> keys-max-height: 300px;
    out property <length> card-padding: 10px;
    out property <length> row-height: 28px;
    out property <length> field-height: 32px;
    out property <length> button-height: 32px;
    out property <length> icon-size: 20px;
    out property <length> icon-size-small: 16px;
    out property <length> icon-button: 24px;
    // Section headers are small capitals, spaced out a little.
    out property <length> header-letter-spacing: 0.6px;

    // Inter for the interface and JetBrains Mono for the terminal (both SIL OFL 1.1). Until they
    // are bundled (M4 in ROADMAP.md) Slint falls back to the system's faces.
    out property <string> font-ui: "Inter";
    out property <string> font-mono: "JetBrains Mono";
    out property <length> font-caption: 11px;
    out property <length> font-body: 13px;
    out property <length> font-title: 15px;
    out property <length> font-display: 22px;
    out property <length> font-terminal: 13px;
}
